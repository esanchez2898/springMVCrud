# ===== Maven build output =====
target/
*.class
*.war
*.jar
*.ear
!.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties

# ===== IntelliJ IDEA =====
.idea/
*.iml
*.ipr
*.iws
out/

# ===== SmartTomcat (local Tomcat config generated by the IntelliJ plugin) =====
.smarttomcat/

# ===== Eclipse / VS Code / NetBeans =====
.classpath
.project
.settings/
.factorypath
.vscode/
nbproject/
nbbuild/
nbdist/

# ===== Logs and crash dumps =====
*.log
logs/
hs_err_pid*
replay_pid*

# ===== Operating system files =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Secrets and local configuration (never commit these) =====
.env
.env.*
*.pem
*.key
*.p12
*.jks
*.keystore
application-local.properties
application-local.yml

# If application.properties will hold real secrets (DB password, JWT keys),
# uncomment the next line and commit an "application.properties.example" instead:
# src/main/resources/application.properties